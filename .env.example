# DealHound configuration. Copy to .env.local and fill in what you have.
#
# Every key is optional. A source whose keys are missing shows as "not
# configured" and is skipped. With no keys at all, DealHound runs on demo
# fixtures. Keys are read only on the server and never sent to the browser.

# ─── Region ───────────────────────────────────────────────────────────────
# CA or US. Sets currency, tax rules, and which sources apply.
DEFAULT_REGION=CA
# Used for tax and shipping estimates when the shopper doesn't enter one.
# Leave empty to default to Ontario rates.
DEFAULT_POSTAL_CODE=

# ─── Demo data and offline development ────────────────────────────────────
# auto: demo sources run only while no real source is configured (default)
# on:   always include demo sources   off: never
DEMO_MODE=auto
# Make demo sources fail on purpose to see graceful degradation.
# Comma-separated <source id>:<error|timeout>. Ids: demo-retail, demo-refurb,
# demo-marketplace, demo-local.
# DEMO_SIMULATE_FAILURES=demo-refurb:error,demo-local:timeout
# 1: every source replays its response from fixtures/<source>/ with no network
# (and runs without keys). Search results are then the same whatever you type.
USE_FIXTURES=0
# 1: save each live response to fixtures/<source>/, overwriting the hand-made
# ones, so USE_FIXTURES replays real data. Access tokens are never saved.
RECORD_FIXTURES=0

# ─── Politeness ───────────────────────────────────────────────────────────
# The User-Agent for the APIs and Apple's refurbished store. Include a way to
# reach you, so site operators can get in touch instead of blocking. (Kijiji,
# Facebook Marketplace and Craigslist are read as desktop Chrome, like carbuyer.)
DEALHOUND_USER_AGENT="DealHound/0.1 (+mailto:you@example.com)"

# ─── LLM: reading queries (phase 2) and matching listings (phase 4) ───────
# Rules read common products for free; the LLM only sees the rest, and each
# answer is cached for a day. Leave every key empty to run on rules alone.
# Prices as of September 2026, per 1M tokens in / out:
#   openai  gpt-5-nano             $0.05 / $0.40 (default)
#   gemini  gemini-2.5-flash-lite  free within Google's daily limits, then $0.10 / $0.40
#   custom  any OpenAI-compatible endpoint (Groq, OpenRouter, a local Ollama)
#   none    rules only
LLM_PROVIDER=openai
# https://platform.openai.com/api-keys (API usage is billed separately from ChatGPT)
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides. Changing the model drops the preset's reasoning setting,
# so set LLM_REASONING_EFFORT yourself if the new model supports one.
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=
# Required for LLM_PROVIDER=custom, with LLM_BASE_URL and LLM_MODEL:
# LLM_API_KEY=

# ─── eBay Browse API ──────────────────────────────────────────────────────
# Join the eBay Developers Program at https://developer.ebay.com/join, then
# create a Production keyset at https://developer.ebay.com/my/keys.
# Client ID = "App ID", client secret = "Cert ID".
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_CA for Canada, EBAY_US for the US.
EBAY_MARKETPLACE_ID=EBAY_CA

# ─── SerpAPI: Google Shopping ─────────────────────────────────────────────
# Covers most retailers (Best Buy, Amazon, Walmart, Costco, Staples, …).
# Sign up at https://serpapi.com/users/sign_up; key at
# https://serpapi.com/manage-api-key. The free plan has a monthly search
# quota; results are cached for an hour to stretch it.
SERPAPI_API_KEY=

# ─── Best Buy API, US only (optional) ─────────────────────────────────────
# https://developer.bestbuy.com/ (used only when the region is US)
BESTBUY_API_KEY=

# ─── Apple Certified Refurbished ──────────────────────────────────────────
# Reads Apple's public refurbished store with DEALHOUND_USER_AGENT, only
# where Apple's robots.txt allows. Cached 30 min.
APPLE_REFURB_ENABLED=0

# ─── Marketplaces read like carbuyer ──────────────────────────────────────
# Logged-out pages and public feeds, requested as a desktop browser, one
# request per search, cached 30 min. The first refusal or login wall rests
# that source for 30 min. Their terms prohibit automated access, so these are
# off until you opt in; see the README.
KIJIJI_ENABLED=0
# Searches Buy & Sell in your province. To narrow it, use <slug>/<location id>
# from a Kijiji URL, e.g. city-of-toronto/1700273
# KIJIJI_LOCATION=
FACEBOOK_ENABLED=0
# Ontario and Québec default to Toronto and Montréal. Elsewhere, set a city:
# a word token (toronto, ottawa, windsor, montreal, quebec) or the numeric id
# from facebook.com/marketplace/<id>/. A wrong token silently returns another
# city's listings.
# FACEBOOK_CITY=
CRAIGSLIST_ENABLED=0
# Ontario and Québec default to Toronto and Montréal. Name up to two areas:
# toronto, ottawa, hamilton, kitchener, london, windsor, niagara, guelph,
# barrie, kingston, peterborough, sudbury, montreal, quebec, sherbrooke, or
# host:id for any other (ids at https://reference.craigslist.org/Areas).
# CRAIGSLIST_SITES=toronto,hamilton

# ─── Saved searches and alerts (phase 6, planned) ─────────────────────────
# Vercel Cron sends this as a bearer token; any long random string.
CRON_SECRET=
# Telegram: create a bot with https://t.me/BotFather, then message it and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend: https://resend.com/api-keys
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Durable storage for saved searches (and a shared cache): Upstash Redis,
# https://console.upstash.com/ (also available from the Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
